# Globale Konfiguration
{
	email {$ACME_EMAIL}
	# Für Erstaufbau / Tests Let's-Encrypt-Staging einkommentieren,
	# um Rate-Limits zu vermeiden:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# X-Real-IP setzt Caddy selbst auf die echte Adresse: Caddy reicht einen vom Client
# mitgeschickten Header sonst unverändert durch, und die Apps lesen ihn mit
# AUTH_TRUST_PROXY_HEADERS=true zuerst (Ratenbegrenzung der Anmeldung).
(proxy_real_ip) {
	header_up X-Real-IP {remote_host}
}

{$RINGWERK_HOST} {
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	reverse_proxy app-ringwerk:3000 {
		import proxy_real_ip
	}
}

# Treffsicher läuft nicht mehr ([[adr-033]], Stufe 4): Jede Adresse des Hosts, auch ein alter Link auf eine Einheit,
# zeigt dieselbe Hinweisseite (caddy/treffsicher/index.html, gemountet nach /srv/treffsicher). `templates` setzt dort
# den Host von Spiegel in den Link.
{$TREFFSICHER_HOST} {
	encode zstd gzip
	root * /srv/treffsicher
	rewrite * /index.html
	templates
	header Cache-Control "no-store"
	file_server
}

# Spiegel nimmt Stapel der Brücke bis 4 MiB an (MAX_SNAPSHOTS_BYTES). Caddy liegt knapp darüber: Ein etwas zu großer
# Stapel bekommt die JSON-Antwort der App (`too-large`), die die Brücke versteht; alles darüber hält Caddy auf.
{$SPIEGEL_HOST} {
	encode zstd gzip
	request_body {
		max_size 5MiB
	}
	reverse_proxy app-spiegel:3000 {
		import proxy_real_ip
	}
}
