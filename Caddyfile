# Globale Konfiguration
{
	email {$ACME_EMAIL}
	# Für Erstaufbau / Tests Let's-Encrypt-Staging einkommentieren,
	# um Rate-Limits zu vermeiden:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# X-Real-IP setzt Caddy selbst auf die echte Adresse: Caddy reicht einen vom Client
# mitgeschickten Header sonst unverändert durch, und die Apps lesen ihn mit
# AUTH_TRUST_PROXY_HEADERS=true zuerst (Ratenbegrenzung der Anmeldung).
(proxy_real_ip) {
	header_up X-Real-IP {remote_host}
}

{$RINGWERK_HOST} {
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	reverse_proxy app-ringwerk:3000 {
		import proxy_real_ip
	}
}

{$TREFFSICHER_HOST} {
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	reverse_proxy app-treffsicher:3000 {
		import proxy_real_ip
	}
}
