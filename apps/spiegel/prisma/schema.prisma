// Spiegel (ADR-031): Rohdaten als Zeilenversionen, kanonische Scheiben mit Revisionen und eine
// Projektion je Scheibe für die Übersichten. Logisches Modell: vault/spiegel/spiegel-data-model.md.
// Prisma 7: Client lokal generiert, Import über "@/generated/prisma/client".
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: url nicht im Schema; Verbindung über @prisma/adapter-pg in src/lib/db.ts
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Scoring {
  decimal
  rings
}

enum CardKind {
  training
  competition
}

// offen (es kommen noch Schüsse), ruhend (seit einer Weile still), endgültig (SF-66)
enum CardState {
  open
  resting
  final
}

// Rohdaten der Anlage oder nur ein gescannter Ausdruck (QR, fremde Anlage)
enum CardOrigin {
  raw
  pdf
}

enum UserRole {
  ADMIN
  USER
}

// ─────────────────────────────────────────────────────────────────────────────
// Anlage, Quelle, Brücke
// ─────────────────────────────────────────────────────────────────────────────

// Schießstand eines Vereins; eine reicht im Normalfall (ADR-029, keine Mandanten)
model Site {
  id          Int                @id @default(autoincrement())
  name        String
  // IANA-Zone der Anlage: Meyton speichert Ortszeit ohne Zone
  timeZone    String
  // Salz der gehashten SportpassIDs für die Brücke (`GET /state`, SF-38); entsteht beim ersten Abruf
  consentSalt String?
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  sources     Source[]
  bridges     Bridge[]
  disciplines Discipline[]
  rankings    Ranking[]
  pairings    BridgePairing[]
  clock       ClockReading[]
  consents    SportpassConsent[]
}

// eine SSMDB2-Instanz in einer Epoche (Ablage geleert, neuer Server: neue Epoche, SF-23). ScheibenIDs sind nur
// innerhalb einer Quelle eindeutig.
model Source {
  id          Int           @id @default(autoincrement())
  siteId      Int
  site        Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  epoch       Int
  // vom Admin bestätigt (die erste Epoche einer Anlage gilt mit dem ersten Snapshot); unbestätigt nimmt Spiegel nichts an
  confirmedAt DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  snapshots   RawSnapshot[]
  rows        RawRow[]
  cards       Card[]
  tombstones  Tombstone[]
  locks       DeleteLock[]

  @@unique([siteId, epoch])
}

// gekoppeltes Gerät an der Anlage; nur der Hash des Tokens wird gespeichert
model Bridge {
  id              Int             @id @default(autoincrement())
  siteId          Int
  site            Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name            String
  tokenHash       String          @unique
  version         String?
  // höchstens einmal je Minute geschrieben (Last)
  lastSeenAt      DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime?       @db.Timestamptz(3)
  // Beginn des laufenden Laufs der Brücke; ein neuer Lauf heißt: die Anlage war aus (Zustand `final`)
  runStartedAt    DateTime?       @db.Timestamptz(3)
  lastHeartbeatAt DateTime?       @db.Timestamptz(3)
  // der letzte Heartbeat (API v1, ohne Personen) für die Anzeige im Admin
  heartbeat       Json?
  snapshots       RawSnapshot[]
  pairings        BridgePairing[]
}

// Einmal-Code zum Koppeln einer Brücke: nur gehasht, 15 Minuten gültig, einmal einlösbar
model BridgePairing {
  id          Int       @id @default(autoincrement())
  siteId      Int
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name        String
  codeHash    String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  bridgeId    Int?
  bridge      Bridge?   @relation(fields: [bridgeId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
}

// Uhrabweichung der Anlage aus dem Heartbeat (Anlage minus Brücke), mit Messzeitpunkt (SF-29); neu nur bei Änderung
model ClockReading {
  id         Int      @id @default(autoincrement())
  siteId     Int
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  measuredAt DateTime @db.Timestamptz(3)
  offsetMs   Int

  @@index([siteId, measuredAt])
}

// Zustimmung eines Kontos für eine SportpassID an einer Anlage (Opt-in, ADR-028): nur bestätigte zählen. Eine SportpassID
// gehört an einer Anlage höchstens einem Konto; mehrdeutige ordnet Spiegel nie automatisch zu ([[spiegel-assignment]]).
// Der Schütze stimmt im Profil zu, ein Admin bestätigt oder lehnt ab (Zustände in `src/lib/consent/status.ts`)
model SportpassConsent {
  id                   Int       @id @default(autoincrement())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId               Int
  site                 Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sportpassId          BigInt
  // wann der Schütze dem Hinweistext zugestimmt hat
  consentedAt          DateTime  @default(now()) @db.Timestamptz(3)
  // Version des Hinweistexts; der Wortlaut steht unveränderlich im Code (`CONSENT_TEXTS`)
  consentVersion       String    @default("v1")
  // vom Admin bestätigt: nur dann lädt die Brücke hoch
  confirmedAt          DateTime? @db.Timestamptz(3)
  // vom Admin abgelehnt; geht vor allem anderen
  rejectedAt           DateTime? @db.Timestamptz(3)
  // zurück beim Admin, weil die erste Scheibe „nicht meine“ war
  returnedAt           DateTime? @db.Timestamptz(3)
  // der Schütze hat die erste Scheibe als seine bestätigt; vorher wartet jede auf ihn (`Card.ownerPending`)
  firstCardConfirmedAt DateTime? @db.Timestamptz(3)
  // ältere Scheiben unter dieser Nummer nachgeladen: ohne, und aktiv, ist es ein offener Auftrag an die Brücke
  historyLoadedAt      DateTime? @db.Timestamptz(3)
  // wann der Auftrag zum Nachladen eröffnet wurde (Bestätigen, Meldungen aufheben): unterscheidet einen neuen Auftrag
  // derselben Zustimmung von einem erledigten; null bei alten Zeilen, dann gilt `confirmedAt`
  historyRequestedAt   DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([siteId, sportpassId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Rohdaten (unverändert, SF-25 bis SF-27)
// ─────────────────────────────────────────────────────────────────────────────

// eine Zeile einer SSMDB2-Tabelle in einer Fassung: neu gespeichert nur, wenn es sie mit diesem Inhalt für die
// Scheibe noch nicht gibt. Ein Snapshot verweist auf seine Zeilen (`RawSnapshot.rowIds`).
model RawRow {
  id         BigInt   @id @default(autoincrement())
  sourceId   Int
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  scheibenId Int
  // "scheiben", "serien" oder "treffer"
  table      String
  // sha256 über die kanonische Form der Zeile (RFC 8785)
  checksum   String
  // json statt jsonb: jsonb nimmt kein U+0000, das der Vertrag in Zellen erlaubt, und json hält den Text unverändert
  values     Json     @db.Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([sourceId, scheibenId, table, checksum])
}

// Spaltenlisten (Name → Typ) der drei Tabellen; ändern sich nur mit der Meyton-Version
model RawColumnSet {
  id        Int           @id @default(autoincrement())
  checksum  String        @unique
  columns   Json          @db.Json
  snapshots RawSnapshot[]
}

// ein Stand einer Scheibe von der Brücke (Snapshot v1): die Hülle und die Verweise auf die Zeilen
model RawSnapshot {
  id              BigInt         @id @default(autoincrement())
  sourceId        Int
  source          Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  scheibenId      Int
  // Folgenummer der Brücke, streng steigend (SF-26): die erste, mit der dieser Stand kam
  sequence        BigInt
  // die letzte, mit der derselbe Stand wieder kam; ein späterer Snapshot mit kleinerer Nummer ist veraltet
  lastSequence    BigInt
  lastObservedAt  DateTime       @db.Timestamptz(3)
  bridgeId        Int?
  bridge          Bridge?        @relation(fields: [bridgeId], references: [id], onDelete: SetNull)
  contractVersion Int
  sourceVersion   String?
  sessionTimeZone String
  observedAt      DateTime       @db.Timestamptz(3)
  receivedAt      DateTime       @default(now()) @db.Timestamptz(3)
  // Prüfsumme über data wie im Vertrag (`computeChecksum`)
  checksum        String
  columnSetId     Int
  columnSet       RawColumnSet   @relation(fields: [columnSetId], references: [id])
  // RawRow-Ids je Tabelle, in kanonischer Folge der Zeilen
  scheibenRowIds  BigInt[]
  serienRowIds    BigInt[]
  trefferRowIds   BigInt[]
  // Prüfsumme ohne das Lebenszeichen (`Scheiben.Zeitstempel`): gleich heißt, nur das Lebenszeichen hat sich bewegt
  contentChecksum String?
  // das zuletzt gesehene Lebenszeichen (Text) und wann es gesehen wurde (Beobachtungszeit)
  lifesign        String?
  lifesignAt      DateTime?      @db.Timestamptz(3)
  // Adapter, der den Stand gedeutet hat; null: nicht gedeutet
  adapterVersion  String?
  // unbekanntes Schema (SF-25): warum keine Scheibe entstand
  quarantine      String?
  revisions       CardRevision[]

  @@unique([sourceId, scheibenId, sequence])
  // Wasserstand für die Brücke (`GET /state`): der jüngste Stand je Quelle, ohne alle zu lesen
  @@index([sourceId, lastObservedAt])
}

// abgelehnte oder fremde Scheibe, die nicht wiederkommen darf; die Brücke kennt sie auch
model Tombstone {
  id          Int      @id @default(autoincrement())
  sourceId    Int
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  scheibenId  Int
  // Zyklus der ScheibenID wie an der Scheibe (SF-77); der Beginn hilft dem Adapter, ihn zu erkennen
  cycle       Int      @default(0)
  startedAt   DateTime @db.Timestamptz(3)
  reason      String
  // wer die Scheibe gemeldet hat („Nicht meine“): Papierkorb des Schützen; null, wenn das Konto gelöscht ist
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // unter welcher SportpassID die Scheibe kam: ordnet den Grabstein einer Zustimmung zu
  sportpassId BigInt?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([sourceId, scheibenId, cycle])
  @@index([userId])
}

// eigene, endgültig gelöschte Scheibe: nicht von selbst wieder annehmen; ausdrückliches Holen hebt die Sperre auf
model DeleteLock {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId   Int
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  scheibenId Int
  cycle      Int      @default(0)
  startedAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, sourceId, scheibenId, cycle])
  // beim Einlesen: gibt es für diese Scheibe eine Sperre, egal von wem?
  @@index([sourceId, scheibenId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Konten
// ─────────────────────────────────────────────────────────────────────────────

// Konto eines erwachsenen Mitglieds; keine Selbstregistrierung, Admin legt an ([[spiegel-privacy]])
model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String             @unique
  passwordHash       String
  // steigt bei Passwortwechsel und Reset: ältere Sitzungen (JWT) gelten nicht mehr
  sessionVersion     Int                @default(0)
  role               UserRole           @default(USER)
  // deaktiviert statt gelöscht
  isActive           Boolean            @default(true)
  // ein Passwort vom Admin (neues Konto, Zurücksetzen) muss der Schütze ersetzen, bevor er Daten sieht: sonst kennte der
  // Admin es und sähe seine Schüsse ([[spiegel-privacy]])
  mustChangePassword Boolean            @default(false)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  cards              Card[]
  periods            NamedPeriod[]
  deleteLocks        DeleteLock[]
  tombstones         Tombstone[]
  familyScorings     FamilyScoring[]
  consents           SportpassConsent[]
}

// benannter Zeitraum des Schützen („Vorbereitung Landesmeisterschaft“), Tage in der Anzeige-Zone
model NamedPeriod {
  id        String    @id @default(cuid())
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  from      DateTime  @db.Date
  to        DateTime? @db.Date
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([ownerId])
}

// Brute-Force-Schutz der Anmeldung (`@vereinsheim/lib/auth/rate-limit`), wie Ringwerk
model LoginRateLimitBucket {
  // „email:<normalisiert>“ oder „ip:<normalisiert>“
  key             String    @id
  attempts        Int
  windowStartedAt DateTime  @db.Timestamptz(3)
  blockedUntil    DateTime? @db.Timestamptz(3)
  lastAttemptAt   DateTime  @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([lastAttemptAt])
  @@index([blockedUntil])
}

// ─────────────────────────────────────────────────────────────────────────────
// Disziplinen
// ─────────────────────────────────────────────────────────────────────────────

// was in Verläufen zusammen zählt, etwa LP Freihand (LP 40, LP 40 alt, LP Training)
model Family {
  id          Int             @id @default(autoincrement())
  // Kennung, steht in der Adresse: aus dem Fachkern (`FamilyId`, etwa „lp-freihand“) oder beim Anlegen aus dem Namen;
  // fest
  slug        String          @unique
  // Anzeige, etwa „Luftpistole“
  name        String
  disciplines Discipline[]
  cards       Card[]
  scorings    FamilyScoring[]
}

// Wertung einer Familie für die Schnitte des Schützen (Liste, Start, Fortschritt), umgestellt und automatisch
// gespeichert; ohne Zeile die häufigste Wertung ihrer Scheiben (`familyScoringOf`)
model FamilyScoring {
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId Int
  family   Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  scoring  Scoring

  @@id([userId, familyId])
}

// Meyton-Disziplin; Vereinsvarianten können dieselbe DisziplinID tragen (SF-70)
model Discipline {
  id              Int      @id @default(autoincrement())
  siteId          Int
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  meytonId        Int
  name            String
  familyId        Int?
  family          Family?  @relation(fields: [familyId], references: [id], onDelete: SetNull)
  // Scheibenbild aus shot-core (`TARGETS`); null: unbekannt (ADR-029)
  targetId        String?
  // amtliche Wertung (SF-74); null: unbekannt
  officialScoring Scoring?
  // Wertungsschüsse vom Admin; null: aus der DisziplinID, 0: keine feste Zahl (SF-09)
  plannedShots    Int?
  // vom Admin eingeordnet; null: neu, die Werte sind der Vorschlag des Einlesens
  confirmedAt     DateTime? @db.Timestamptz(3)
  // steigt, wenn sich Scheibenbild oder Schusszahl ändern; Scheiben mit anderem Stand rechnet
  // `refreshStaleDisciplineCards` nach
  version         Int       @default(0)
  // ignoriert (Spaßscheiben): Spiegel zeigt ihre Scheiben nirgends, die Scheiben bleiben gespeichert; mit
  // `confirmedAt` null ein Vorschlag des Einlesens (Meytons Spiele und Trainingsscheiben)
  ignoredAt       DateTime? @db.Timestamptz(3)
  cards           Card[]

  @@unique([siteId, meytonId, name])
}

// eine `Rangliste` der Anlage, ein freier Text des Vereins; das Einlesen legt sie beim ersten Sehen an. Ihre Art ordnet
// der Admin zu (an der Vereinsanlage ist `Status` immer leer, [[meyton-ssmdb2]]); null: nicht zugeordnet
model Ranking {
  id     Int       @id @default(autoincrement())
  siteId Int
  site   Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name   String
  kind   CardKind?
  cards  Card[]

  @@unique([siteId, name])
}

// ─────────────────────────────────────────────────────────────────────────────
// Scheiben
// ─────────────────────────────────────────────────────────────────────────────

// ein Durchgang. Aus Rohdaten: Quelle + ScheibenID eindeutig; nur aus dem PDF: ohne beides.
model Card {
  id                String          @id @default(cuid())
  sourceId          Int?
  source            Source?         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  scheibenId        Int?
  // die ScheibenID ist ein Zähler, der nach etwa 49,7 Tagen wiederkehren kann (SF-77): Zyklus 0, 1, …
  cycle             Int             @default(0)
  // Folgenummer des Snapshots, der die Scheibe zuletzt geschrieben hat; ein älterer ändert nichts (SF-26)
  lastSequence      BigInt?
  // null, solange niemand die Scheibe zugeordnet hat
  ownerId           String?
  owner             User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // der Besitz wartet auf die Bestätigung der ersten Scheibe; bis dahin zeigen die Übersichten sie nicht
  ownerPending      Boolean         @default(false)
  // wie Meyton den Schützen kennt; für die Zuordnung über den Sportpass
  sportpassId       BigInt?
  disciplineId      Int
  // NoAction statt Restrict: prüft am Ende der Anweisung, damit das Löschen einer Anlage über die Quelle kaskadiert
  discipline        Discipline      @relation(fields: [disciplineId], references: [id], onDelete: NoAction)
  // `Discipline.version`, mit der Merkmale, Gegenprobe und `complete` gerechnet sind; -1: ohne Zuordnung geschrieben
  disciplineVersion Int             @default(0)
  // Familie der Disziplin, hier mitgeführt für den Index der Übersichten; ändert die Admin-Zuordnung die
  // Familie, zieht sie die Scheiben mit (`moveDisciplineFamily`)
  familyId          Int?
  family            Family?         @relation(fields: [familyId], references: [id], onDelete: SetNull)
  stand             String?
  startedAt         DateTime        @db.Timestamptz(3)
  endedAt           DateTime?       @db.Timestamptz(3)
  kind              CardKind
  // vom Schützen auf der Seite der Scheibe gewählt; null: die Art der Rangliste, sonst die der Quelle (`kind`). Ein
  // Stand schreibt nur `kind` und `rankingId`
  kindChoice        CardKind?
  // die `Rangliste` der SSMDB2 („Training-LP“, „RWK_…“); ihre Art ordnet der Admin zu
  rankingId         Int?
  ranking           Ranking?        @relation(fields: [rankingId], references: [id], onDelete: SetNull)
  state             CardState
  // endgültig und mit voller Schusszahl (SF-66); die amtliche Wertung steht an der Disziplin (SF-74)
  complete          Boolean
  // wie am Stand: die häufigste Anzeigeart der Schüsse wie am Ausdruck (`standScoringOf`); null: keine Zehntel oder
  // ganzen Ringe gezeigt
  standScoring      Scoring?
  // vom Schützen auf der Seite der Scheibe gewählt; null: die Vorgabe (`cardScoring`)
  scoringChoice     Scoring?
  flags             String[]
  origin            CardOrigin
  currentRevisionId BigInt?         @unique
  currentRevision   CardRevision?   @relation("CurrentRevision", fields: [currentRevisionId], references: [id])
  // Papierkorb: 30 Tage, danach endgültig gelöscht und gesperrt (DeleteLock)
  deletedAt         DateTime?       @db.Timestamptz(3)
  // zuletzt bewegtes Lebenszeichen (Beobachtungszeit, um den Versatz verschoben); Grundlage des Zustands (SF-10)
  lifesignAt        DateTime?       @db.Timestamptz(3)
  // Versatz der Uhr des Stands, gemessen am laufenden Lebenszeichen (SF-73); ab fünf Minuten ausgeglichen
  clockOffsetMs     Int?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  revisions         CardRevision[]  @relation("Revisions")
  shots             Shot[]
  projection        CardProjection?
  printouts         Printout[]

  @@unique([sourceId, scheibenId, cycle])
  // Liste, Fortschritt, Blättern: Scheiben eines Schützen in einer Familie nach Beginn
  @@index([ownerId, familyId, startedAt])
  // Start: der letzte Abend über alle Familien
  @@index([ownerId, startedAt])
  // Heartbeat: offene und ruhende Scheiben einer Quelle weiterschalten
  @@index([sourceId, state])
  // Zählen je Rangliste im Admin, `SET NULL` beim Löschen einer Rangliste
  @@index([rankingId])
  @@index([sportpassId])
  // Nachrechnen nach einer Zuordnung, Familie umhängen, Zählen je Disziplin im Admin
  @@index([disciplineId])
}

// ein Stand der Scheibe; Korrekturen erzeugen eine neue Revision, die vorige bleibt
model CardRevision {
  id            BigInt       @id @default(autoincrement())
  cardId        String
  card          Card         @relation("Revisions", fields: [cardId], references: [id], onDelete: Cascade)
  number        Int
  // sha256 über Schüsse und Merkmale: gleicher Inhalt, keine neue Revision
  contentHash   String
  rawSnapshotId BigInt?
  rawSnapshot   RawSnapshot? @relation(fields: [rawSnapshotId], references: [id], onDelete: SetNull)
  reason        String
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  shots         Shot[]
  currentOf     Card?        @relation("CurrentRevision")

  @@unique([cardId, number])
}

// ein Schuss in einer Revision
model Shot {
  id               BigInt       @id @default(autoincrement())
  revisionId       BigInt
  revision         CardRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  cardId           String
  card             Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  // Abgabefolge über die ganze Scheibe (SF-30)
  seq              Int
  // Stellung, 0 = Probe
  stellung         Int
  treffer          Int
  series           Int?
  // Lage in µm, x nach rechts, y nach oben; null nur aus dem PDF
  xUm              Int?
  yUm              Int?
  ring             Int?
  decimalTenths    Int?
  // Abstand zur Mitte in 0,1 µm, wie Meyton `Teiler001`
  distanceTenthsUm Int?
  innerTen         Boolean
  // Anzeigeart am Monitor (Treffer.Wertung), nie die amtliche Wertung (SF-74)
  displayMode      Int?
  firedAt          DateTime?    @db.Timestamptz(3)
  flags            String[]
  // über Revisionen hinweg derselbe Schuss: Zeit mit ms und Lage
  fingerprint      String

  @@unique([revisionId, stellung, treffer])
  @@index([cardId, fingerprint])
}

// Kennzahlen und Rekord-Kandidaten der aktuellen Revision (shot-core `cardProjection`), für Liste, Fortschritt und
// Start ohne Schüsse; neu gerechnet beim Schreiben einer Revision und wenn `version` veraltet ist
model CardProjection {
  cardId       String   @id
  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  revisionId   BigInt
  version      String
  probeOnly    Boolean
  suspicious   Boolean
  printedShots Int
  values       Json
  records      Json
  /// Lagen der Schüsse wie am Ausdruck für die kleinen Scheiben (`cardMarks`, je [x, y, Ring] in 10 µm)
  marks        Json
  computedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([version])
}

// gespeicherter Meyton-Ausdruck mit gelesener ID im Fuß und Erstellzeit (meyton-pdf)
model Printout {
  id        String    @id @default(cuid())
  cardId    String
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  sha256    String
  fileName  String
  size      Int
  footerId  String?
  printedAt DateTime? @db.Timestamptz(3)
  storedAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([cardId, sha256])
  // gleiche ID im Fuß ist gleiche Scheibe (SF-43)
  @@index([footerId])
}
