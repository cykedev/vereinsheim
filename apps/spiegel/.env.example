# ── Host-Dev im Monorepo ─────────────────────────────────────────────────────
# Postgres kommt aus der Root-`docker-compose.dev.yml` (geteilter Container).
# Die App läuft auf dem Host via `pnpm dev` → Verbindung via localhost:5432 auf
# die Dev-DB "spiegel". Kopiere diese Datei nach `.env` (gitignored);
# `scripts/bootstrap-dev.sh` tut das, wenn sie fehlt.

# Datenbankverbindung
DATABASE_URL=postgresql://spiegel:spiegel@localhost:5432/spiegel

# Anzeigezeitzone (IANA). DB speichert immer UTC.
DISPLAY_TIME_ZONE=Europe/Berlin
