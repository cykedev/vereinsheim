# ── Host-Dev im Monorepo ─────────────────────────────────────────────────────
# Postgres kommt aus der Root-`docker-compose.dev.yml` (geteilter Container).
# Die App läuft auf dem Host via `pnpm dev` → Verbindung via localhost:5432 auf
# die Dev-DB "spiegel". Kopiere diese Datei nach `.env` (gitignored);
# `scripts/bootstrap-dev.sh` tut das, wenn sie fehlt.

# Datenbankverbindung
DATABASE_URL=postgresql://spiegel:spiegel@localhost:5432/spiegel

# Anzeigezeitzone (IANA). DB speichert immer UTC.
DISPLAY_TIME_ZONE=Europe/Berlin

# NextAuth (lokal: beliebiger langer Wert; in Produktion geheim, mindestens 32 Zeichen)
NEXTAUTH_SECRET=dev-secret-fuer-lokale-entwicklung-min32z
NEXTAUTH_URL=http://localhost:3002

# Erstes Admin-Konto (wird beim ersten Start angelegt, nur wenn noch kein Admin existiert).
# Lokal: eigene E-Mail und ein Passwort mit mindestens 12 Zeichen eintragen;
# `pnpm --filter spiegel seed:own` ordnet die eigenen Scheiben diesem Konto zu.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-passwort-12

# Ausdrucke (PDF); in Produktion ein Volume
UPLOAD_DIR=./uploads

# Ratenbegrenzung der Anmeldung (Host-Dev ohne Reverse-Proxy → false)
AUTH_TRUST_PROXY_HEADERS=false
AUTH_RATE_LIMIT_MAX_BUCKETS=10000
