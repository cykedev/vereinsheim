{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bridgeId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "token": {
      "type": "string",
      "pattern": "^spgl_[A-Za-z0-9_-]{43}$"
    },
    "site": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "timeZone": {
          "type": "string"
        }
      },
      "required": ["name", "timeZone"],
      "additionalProperties": false
    }
  },
  "required": ["bridgeId", "token", "site"],
  "additionalProperties": false,
  "title": "Spiegel-Kopplung v1 (Antwort)"
}
