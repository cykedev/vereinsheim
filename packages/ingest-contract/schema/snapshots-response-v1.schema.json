{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "scheibenId": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "outcome": {
            "type": "string",
            "enum": [
              "stored",
              "unchanged",
              "lifesign",
              "stale",
              "future",
              "discarded",
              "quarantined",
              "epoch-unconfirmed"
            ]
          },
          "reason": {
            "type": "string",
            "enum": ["no-consent", "blocked", "hidden"]
          }
        },
        "required": ["index", "scheibenId", "outcome"],
        "additionalProperties": false
      }
    }
  },
  "required": ["results"],
  "additionalProperties": false,
  "title": "Spiegel-Snapshot-Stapel v1 (Antwort)"
}
